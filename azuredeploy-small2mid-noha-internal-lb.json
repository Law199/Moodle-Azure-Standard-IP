{
    "$schema": "https://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "_artifactsLocation": {
            "type": "string",
            "metadata": {
                "description": "The base URI where artifacts required by this template are located. When the template is deployed using the accompanying scripts, a private location in the subscription will be used and this value will be automatically generated."
            },
            "defaultValue": "https://raw.githubusercontent.com/Law199/Moodle-Azure-Standard-IP/master/"
        },
        "_artifactsLocationSasToken": {
            "type": "securestring",
            "metadata": {
                "description": "The sasToken required to access _artifactsLocation.  When the template is deployed using the accompanying scripts, a sasToken will be automatically generated."
            },
            "defaultValue": ""
        },
        "sshPublicKey": {
            "metadata": {
                "description": "ssh public key"
            },
            "type": "string"
        },
        "siteURL": {
            "defaultValue": "www.example.org",
            "metadata": {
                "description": "URL for the Moodle site. Since this deployment uses an internal Load Balancer with no public DNS name, you must set this to the real public hostname that will front this deployment (e.g. the domain configured on your externally-managed Application Gateway). Leaving the default will result in Moodle generating broken links pointing at the internal Load Balancer's private DNS name."
            },
            "type": "string"
        },
        "publicIpSku": {
            "defaultValue": "Standard",
            "allowedValues": [
                "Basic",
                "Standard"
            ],
            "metadata": {
                "description": "Public IP SKU for controller and gateway public IP resources. Use Standard to avoid Basic SKU issues on current Azure deployments."
            },
            "type": "string"
        },
        "controllerVmSku": {
            "defaultValue": "Standard_DS1_v2",
            "allowedValues": [
                "Standard_DS1_v2",
                "Standard_B2s_v2"
            ],
            "metadata": {
                "description": "VM size for the controller VM"
            },
            "type": "string"
        },
        "autoscaleVmSku": {
            "defaultValue": "Standard_DS2_v2",
            "allowedValues": [
                "Standard_DS2_v2",
                "Standard_D2as_v5",
                "Standard_D2as_v6",
                "Standard_D2as_v7"
            ],
            "metadata": {
                "description": "VM size for the Moodle web frontend VM scale set"
            },
            "type": "string"
        }
    },
    "resources": [
        {
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "2017-05-10",
            "name": "mainTemplate",
            "properties": {
                "mode": "Incremental",
                "parameters": {
                    "_artifactsLocation":           { "value": "[parameters('_artifactsLocation')]" },
                    "_artifactsLocationSasToken":   { "value": "[if(empty(parameters('_artifactsLocationSasToken')), '', if(startsWith(parameters('_artifactsLocationSasToken'), '?'), parameters('_artifactsLocationSasToken'), concat('?', parameters('_artifactsLocationSasToken'))))]" },
                    "redisDeploySwitch":            { "value": false },
                    "sshPublicKey":                 { "value": "[parameters('sshPublicKey')]" },
                    "siteURL":                      { "value": "[parameters('siteURL')]" },
                    "publicIpSku":                  { "value": "[parameters('publicIpSku')]" },
                    "controllerVmSku":              { "value": "[parameters('controllerVmSku')]" },
                    "autoscaleVmSku":               { "value": "[parameters('autoscaleVmSku')]" },
                    "dbServerType":                 { "value": "mysqlflex" },
                    "vnetDbDeploySwitch":           { "value": true },
                    "mysqlflexSkuName":             { "value": "Standard_D8ds_v4" },
                    "mysqlflexStgIops":             { "value": 1000 },
                    "mysqlflexStgSizeGiB":          { "value": 128 },
                    "fileServerDiskSize":           { "value": 128 },
                    "internalLoadBalancerSwitch":   { "value": true }
                },
                "templateLink": {
                    "uri": "[concat(parameters('_artifactsLocation'), 'azuredeploy.json', if(empty(parameters('_artifactsLocationSasToken')), '', if(startsWith(parameters('_artifactsLocationSasToken'), '?'), parameters('_artifactsLocationSasToken'), concat('?', parameters('_artifactsLocationSasToken')))))]"
                }
            }
        }
    ],
    "outputs": {
        "mainTemplateOutputs": {
            "type": "object",
            "value": "[reference('mainTemplate').outputs]"
        }
    },
    "variables": {
        "documentation01": "This wrapper template calls the main-template with pre-defined configs for small-to-mid size workloads (without high availability) and the only required parameter (sshPublicKey).",
        "documentation02": "For the expected small-to-mid size workloads, other parameters are fixed in this template and overridden as above.",
        "documentation03": "The web tier uses an internal Standard Load Balancer with a NAT Gateway for outbound access."
    }
}